# --- Server ---
PORT=5000
# Comma-separated list of allowed CORS origins (no trailing slash).
# Defaults to localhost + the Vercel URL if unset.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Base URL of the frontend, used to build links in emails (welcome, reset).
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=ClusterName

# --- Auth ---
# Long random string used to sign JWTs.
JWT_SECRET=replace-with-a-long-random-secret

# --- Email (Gmail app password) ---
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your-gmail-app-password
